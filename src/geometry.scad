function hoshi(n) =
	n == 3 ? [
		[1, 1]
	] : n == 9 ? [
		[2, 2], [6, 2],
		    [4, 4],
		[6, 2], [6, 6]
	] : n == 13 ? [
		[3, 3], [9, 3],
		    [6, 6],
		[3, 9], [9, 9]
	] : n == 19 ? [
		[ 3,  3], [ 9,  3], [15,  3],
		[ 3,  9], [ 9,  9], [15,  9],
		[ 3, 15], [ 9, 15], [15, 15]
	] : undef;

function screws(n) =
	n == 3 ? [
		[0, 0], [2, 0],
		[0, 2], [2, 2]
	] : n == 9 ? [
		[0, 0], [8, 0],
		[0, 8], [8, 8]
	] : n == 13 ? [
		[ 0,  0], [ 6,  0], [12,  0],
		[ 0,  6],           [12,  6],
		[ 0, 12], [ 6, 12], [12, 12]
	] : n == 19 ? [
		[ 0,  0], [ 9,  0], [18,  0],
		[ 0,  9],           [18,  9],
		[ 0, 18], [ 9, 18], [18, 18]
	] : undef;